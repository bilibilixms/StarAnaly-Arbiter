{
  "manifest_version": 3,
  "name": "星析 · 图文发布助手",
  "version": "0.7.0",
  "description": "填入小红书与抖音图文内容；小红书发布成功后同步状态并返回星析。",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js", "douyin-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["publication-signal.js", "topic-fill.js", "publisher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.douyin.com/*"],
      "js": ["douyin-publisher.js"],
      "run_at": "document_idle"
    }
  ]
}
