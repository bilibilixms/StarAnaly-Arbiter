{
  "manifest_version": 3,
  "name": "星析 · 小红书发布助手",
  "version": "0.6.0",
  "description": "填入小红书图文内容，发布成功后同步状态并返回星析。",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["publication-signal.js", "topic-fill.js", "publisher.js"],
      "run_at": "document_idle"
    }
  ]
}
