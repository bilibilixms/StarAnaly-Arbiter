# 复制本文件为 .env，并填入真实的值。
# .env 已被 .gitignore 忽略，不会提交到 Git。
# 启动前请务必修改以下密码，不要使用示例值。

# MySQL root 用户密码
MYSQL_ROOT_PASSWORD=change_me

# 应用使用的 MySQL 用户和密码
MYSQL_USER=staranaly
MYSQL_PASSWORD=change_me_too

# Redis 访问密码
REDIS_PASSWORD=change_me

# DeepSeek 模型服务（默认地址与模型如下，只需配置密钥）
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=your_deepseek_api_key
# 也可使用 DEEPSEEK_API_KEY；MODEL_API_KEY 优先。
