# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
/target/

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/dist/
/frontend/*.tsbuildinfo

# 环境变量文件（含密码等敏感配置，禁止提交）
.env
.env.local
.env.*.local

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 本地数据库备份（包含任务、对话与上传内容）
/backups/
